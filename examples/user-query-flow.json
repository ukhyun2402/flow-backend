{
  "specVersion":"1.0","id":"get-user","revision":1,"name":"사용자 조회",
  "inputSchema":{"type":"object","properties":{"userId":{"type":"integer","minimum":1}},"required":["userId"],"additionalProperties":false},
  "outputSchema":{"type":"object","properties":{"id":{"type":"integer"},"name":{"type":"string"}},"required":["id","name"]},
  "resources":{"databases":["main"],"services":[]},
  "nodes":[
    {"id":"start","type":"trigger.http","name":"조회 요청","config":{"method":"GET","path":"/users/{userId}","input":{"userId":{"source":"path.userId","convert":"integer"}}}},
    {"id":"validate","type":"validate","name":"입력 검증","config":{"schema":{"type":"object","properties":{"userId":{"type":"integer","minimum":1}},"required":["userId"]}}},
    {"id":"query","type":"db.query","name":"사용자 조회","config":{"databaseRef":"main","sql":"SELECT id AS \"id\", name AS \"name\" FROM users WHERE id = :userId","parameters":{"userId":{"ref":"input.userId"}},"resultMode":"zeroOrOne","outputSchema":{"type":"object","properties":{"row":{"type":["object","null"],"properties":{"id":{"type":"integer"},"name":{"type":"string"}}}}}}},
    {"id":"found","type":"branch","name":"사용자 존재","config":{"condition":{"op":"notNull","args":[{"ref":"nodes.query.output.row"}]}}},
    {"id":"ok","type":"response.http","name":"정상 응답","config":{"status":200,"body":{"ref":"nodes.query.output.row"}}},
    {"id":"missing","type":"error.raise","name":"사용자 없음","config":{"code":"USER_NOT_FOUND","status":404,"message":"사용자를 찾을 수 없습니다."}}
  ],
  "edges":[{"from":"start","port":"success","to":"validate"},{"from":"validate","port":"success","to":"query"},{"from":"query","port":"success","to":"found"},{"from":"found","port":"true","to":"ok"},{"from":"found","port":"false","to":"missing"}],
  "settings":{"timeoutMs":10000,"authentication":"bearer"},
  "ui":{"positions":{"start":{"x":0,"y":100},"validate":{"x":250,"y":100},"query":{"x":500,"y":100},"found":{"x":750,"y":100},"ok":{"x":1000,"y":20},"missing":{"x":1000,"y":200}}}
}
