{
  "name": "flow-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "format": "prettier --plugin=prettier-plugin-java --write \"../src/**/*.java\" \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --plugin=prettier-plugin-java --check \"../src/**/*.java\" \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@xyflow/react": "12.8.5",
    "monaco-editor": "0.52.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "5.9.3",
    "vite": "7.1.9"
  }
}
